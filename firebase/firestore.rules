rules_version = '2';
// INTENTIONALLY VULNERABLE: SecureIndie demo app. A "test mode" style rule that
// was never replaced: anyone, logged in or not, can read every document.
// (Writes are closed so the public demo can't be abused.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.time < timestamp.date(2027, 6, 1);
      allow write: if false;
    }
  }
}
